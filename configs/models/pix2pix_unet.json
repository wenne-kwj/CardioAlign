{
  "name": "pix2pix_unet",
  "model": {
    "input_nc": 1,
    "output_nc": 3,
    "ngf": 64,
    "ndf": 64,
    "norm": "batch",
    "dropout": true,
    "num_downs": 8
  },
  "loss": {
    "gan_mode": "vanilla",
    "lambda_L1": 100.0,
    "real_label": 1.0
  },
  "training": {
    "optimizer": "Adam",
    "learning_rate": 0.0002,
    "discriminator_learning_rate": 0.0002,
    "betas": [
      0.5,
      0.999
    ],
    "weight_decay": 0.0,
    "gradient_clip": null,
    "update_order": "D_then_G",
    "steps": 1000,
    "batch_size": 1
  },
  "sampling": {
    "batchnorm_mode": "current"
  }
}
