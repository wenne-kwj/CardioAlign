{
  "name": "flowdit",
  "model": {
    "image_size": 512,
    "patch_size": 8,
    "hidden_size": 384,
    "depth": 12,
    "num_heads": 6,
    "mlp_ratio": 4.0,
    "condition_mode": "dense",
    "condition_width": 32,
    "dropout": 0.0,
    "gradient_checkpointing": false,
    "aligned_condition": true
  },
  "flow": {
    "loss_denominator_floor": 0.05,
    "time_distribution": "logit_normal_uniform_mixture",
    "logit_mean": -0.8,
    "logit_std": 0.8,
    "uniform_probability": 0.5
  },
  "sampling": {
    "method": "euler",
    "steps": 50,
    "clip_x0": true
  },
  "loss": {
    "type": "x_prediction_velocity_mse"
  },
  "training": {
    "learning_rate": 0.0001,
    "betas": [
      0.9,
      0.999
    ],
    "weight_decay": 0.0,
    "gradient_clip": 1.0,
    "steps": 1000,
    "batch_size": 1,
    "optimizer": "AdamW",
    "ema_decay": 0.999
  }
}
