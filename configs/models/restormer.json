{
  "name": "restormer",
  "model": {
    "in_channels": 1,
    "out_channels": 3,
    "dim": 32,
    "num_blocks": [
      4,
      6,
      6,
      8
    ],
    "num_refinement_blocks": 4,
    "heads": [
      1,
      2,
      4,
      8
    ],
    "ffn_expansion_factor": 2.66,
    "bias": false,
    "layer_norm_type": "WithBias",
    "output_activation": "sigmoid",
    "auto_pad": true
  },
  "loss": {
    "charbonnier_weight": 0.8,
    "ssim_weight": 0.2,
    "epsilon": 0.001,
    "ssim_window_size": 11,
    "ssim_sigma": 1.5
  },
  "training": {
    "learning_rate": 0.0002,
    "betas": [
      0.9,
      0.999
    ],
    "weight_decay": 0.0001,
    "gradient_clip": 1.0,
    "steps": 1000,
    "batch_size": 1,
    "optimizer": "AdamW"
  }
}
