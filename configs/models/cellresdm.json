{
  "name": "cellresdm",
  "model": {
    "image_size": 512,
    "model_channels": 160,
    "channel_mult": [
      1,
      2,
      2,
      4
    ],
    "num_res_blocks": [
      2,
      2,
      2,
      2
    ],
    "attention_resolutions": [
      64,
      32,
      16,
      8
    ],
    "swin_depth": 2,
    "swin_embed_dim": 192,
    "window_size": 8,
    "num_head_channels": 32,
    "mlp_ratio": 4.0,
    "dropout": 0.0
  },
  "diffusion": {
    "steps": 15,
    "power": 0.3,
    "kappa": 2.0,
    "sqrt_eta_end": 0.99,
    "min_noise_level": 0.2,
    "input_scaling": "variance",
    "clip_xstart": false
  },
  "loss": {
    "lpips_weight": 1.0,
    "pretrained_cache": null
  },
  "training": {
    "learning_rate": 5e-05,
    "betas": [
      0.9,
      0.999
    ],
    "weight_decay": 0.0,
    "gradient_clip": 1.0,
    "steps": 1000,
    "batch_size": 1,
    "optimizer": "AdamW",
    "ema_decay": 0.999
  }
}
