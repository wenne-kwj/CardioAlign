{
  "name": "unet",
  "model": {
    "in_channels": 1,
    "out_channels": 3,
    "base_channels": 32,
    "bottleneck_dropout": 0.1,
    "output_activation": "sigmoid",
    "auto_pad": true
  },
  "loss": {
    "charbonnier_weight": 0.8,
    "ssim_weight": 0.2,
    "epsilon": 0.001,
    "ssim_window_size": 11,
    "ssim_sigma": 1.5
  },
  "training": {
    "learning_rate": 0.0003,
    "betas": [
      0.9,
      0.999
    ],
    "weight_decay": 0.0001,
    "gradient_clip": 1.0,
    "steps": 1000,
    "batch_size": 1,
    "optimizer": "AdamW"
  }
}
